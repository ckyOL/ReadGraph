# ===================================================
# ReadGraph npm 安全加固配置
# 本文件受版本控制，未经安全审查不得修改
# 参考规范: docs/npm-supply-chain-security.md
# ===================================================

# [关键] 禁止安装脚本自动执行
# 防止 preinstall / install / postinstall 脚本运行任意代码
ignore-scripts=true

# [关键] 强制精确版本锁定
# 防止 caret (^) 范围允许自动升级到恶意版本
save-exact=true

# [关键] 新包冷却期 — 7 天
# 绝大多数恶意包在发布后数小时至数天内被社区发现并移除
# 此设置拒绝安装发布不满 7 天的包版本
min-release-age=7d

# [重要] 启用安全审计
audit=true
audit-level=high

# [重要] 仅使用官方 npm 注册表
registry=https://registry.npmjs.org/

# [安全] 强制 HTTPS
strict-ssl=true
